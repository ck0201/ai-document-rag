# =====================================================================
# Enterprise RAG Service Configuration
# =====================================================================

# LLM Provider Selection ("gemini", "ollama", or "mock")
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Ollama Local Configuration (Used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Vector Store Engine ("pgvector" or "chroma")
VECTOR_STORE_TYPE=pgvector

# PostgreSQL + pgvector Configuration
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# FastAPI Server Port
PORT=8000
